# Секретов в этом файле нет; секреты — через Vault и/или *_FILE переменные на этапе инициализации

# DOMAIN
DOMAIN_ROOT=terminal.speculorg.localhost

# CONSUL
CONSUL_SERVICE_NAME=consul
CONSUL_HTTP_ADDR=consul
CONSUL_HTTP_PORT=8500
CONSUL_HTTPS_ADDR=consul
CONSUL_HTTPS_PORT=8501
CONSUL_TLS_ENABLED=true

# VAULT
VAULT_SERVICE_NAME=vault
VAULT_HTTP_ADDR=vault
VAULT_HTTP_PORT=8200
VAULT_HTTPS_ADDR=vault
VAULT_HTTPS_PORT=8200
VAULT_TLS_ENABLED=true
VAULT_PKI_ROOT_PATH=pki-root
VAULT_PKI_INT_PATH=pki-int
VAULT_PKI_ROLE_NAME=terminal-leaf
VAULT_CERT_ROTATE_HOURS=24

# TRAEFIK
TRAEFIK_SERVICE_NAME=traefik
TRAEFIK_HTTP_PORT=8080
TRAEFIK_HTTPS_PORT=8443
TRAEFIK_TLS_ENABLED=true

# TLS / PKI
TLS_ENABLED=true
TLS_CERTS_DIR=/certs
PKI_LEAF_TTL_HOURS=24
PKI_SAN_LIST=consul.$${DOMAIN_ROOT},consul,vault.$${DOMAIN_ROOT},vault,traefik.$${DOMAIN_ROOT},traefik,db.$${DOMAIN_ROOT},database,kc.$${DOMAIN_ROOT},keycloak,mq.$${DOMAIN_ROOT},rabbitmq

# OBSERVABILITY
OBS_PROMETHEUS_PORT=9090
OBS_GRAFANA_PORT=3000
OBS_SCRAPE_INTERVAL=15s

# SERVICE DEFAULTS
SERVICE_HEALTH_DIR=/run/terminal/health
SERVICE_INIT_TIMEOUT_S=60
SERVICE_RETRY_INTERVAL_S=2
SERVICE_BACKOFF_FACTOR=1.5
SERVICE_MAX_RETRY_INTERVAL_S=15

# DATABASE
DB_SERVICE_NAME=database
DB_HTTP_PORT=8444

# KEYCLOAK
KC_SERVICE_NAME=keycloak
KC_HTTP_PORT=8445

# RABBITMQ
MQ_SERVICE_NAME=rabbitmq
MQ_HTTP_PORT=8446
