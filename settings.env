# .\settings.env


# Global configuration for Speculorg.Terminal
# Этот файл монтируется в каждый контейнер: /opt/config/settings.cfg


# NAMESPACES
DOMAIN_ROOT=terminal.speculorg.localhost


# DIRECTORIES
DIR_CERTS=/certs
DIR_SECRETS=/secrets


# LOGGING
LOG_LEVEL=INFO


# CONSUL
CONSUL_HOST=consul
CONSUL_PORT_HTTP=8500
CONSUL_PORT_HTTPS=8501
CONSUL_DC=speculorg-dc


# VAULT
VAULT_HOST=vault
VAULT_PORT_HTTP=8200
VAULT_PORT_HTTPS=8200


# TRAEFIK
TRAEFIK_HOST=traefik
TRAEFIK_PORT_HTTP=80
TRAEFIK_PORT_HTTPS=443
