
# DOMAIN
DOMAIN_ROOT=terminal.speculorg.localhost

# PATH/DIR
TLS_CERTS_DIR=/certs                # Volume с PKI-артефактами (root/int/leaf)
SERVICE_HEALTH_DIR=/run/terminal/health

# TIMEOUT/RETRY
SERVICE_INIT_TIMEOUT_S=60
SERVICE_RETRY_INTERVAL_S=2
SERVICE_BACKOFF_FACTOR=1.5
SERVICE_MAX_RETRY_INTERVAL_S=15

# Consul
CONSUL_HOST=consul
CONSUL_HTTP_PORT=8500               # для первичного старта/инициализации
CONSUL_HTTPS_PORT=8501              # рабочий порт под mTLS

# Vault
VAULT_HOST=vault
VAULT_HTTP_PORT=8200                # для первичного старта/инициализации
VAULT_HTTPS_PORT=8200               # рабочий порт под mTLS
VAULT_PKI_ROOT_PATH=pki-root
VAULT_PKI_INT_PATH=pki-int
VAULT_PKI_ROLE=terminal-leaf        # роль для выдачи server leaf-сертификатов

# Traefik
TRAEFIK_HOST=traefik
TRAEFIK_HTTP_PORT=80               # dashboard/http
TRAEFIK_HTTPS_PORT=443             # dashboard/https и публичные роуты

# Postgres
DB_HOST=database
POSTGRES_PORT=5432                  # внутренний порт БД

# Observability
OBS_PROMETHEUS_PORT=9090
OBS_GRAFANA_PORT=3000
OBS_SCRAPE_INTERVAL=15s

# Policy
PKI_LEAF_TTL_HOURS=24               # срок валидности leaf-сертификатов
CERT_ROTATE_HOURS=24                # периодическая ротация (реализуется в коде)
