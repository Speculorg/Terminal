# configs\.env.develop
# Speculorg.Terminal Environment Configuration
# Environment: development

# 🌐 GLOBAL
ENV_MODE=develop
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
HEALTHCHECK_PORT=9099

# 🧭 CONSUL
CONSUL_HOST=consul-service
CONSUL_PORT=8500
CONSUL_DC=speculorg-dev
CONSUL_TIMEOUT=30
CONSUL_CHECK_INTERVAL=10s
CONSUL_CHECK_TIMEOUT=3s

# 🔐 VAULT
VAULT_ADDR=http://vault-service:8200
# VAULT_DEV_ROOT_TOKEN_ID=root
# VAULT_DEV_LISTEN_ADDRESS=0.0.0.0:8200

# 🧊 TRAEFIK
TRAEFIK_PORT=9000

# 🛢 POSTGRESQL
POSTGRES_USER=speculorg
POSTGRES_PASSWORD=speculpwd
POSTGRES_DB=speculorg
POSTGRES_PORT=5432

# 🧠 REDIS
REDIS_PORT=6379

# 📦 RABBITMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 🧑 KEYCLOAK
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=speculorg
KEYCLOAK_CLIENT_ID=infrastructure-service
KEYCLOAK_CLIENT_SECRET=infrastructure-secret
