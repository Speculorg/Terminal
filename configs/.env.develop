# Общие настройки
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here

# Настройки базы данных
DATABASE_URL=postgresql://postgres:postgres@infrastructure-database-module:5432/speculorg
POSTGRES_DB=speculorg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Настройки Redis
REDIS_URL=redis://infrastructure-redis-module:6379/0
REDIS_HOST=infrastructure-redis-module
REDIS_PORT=6379

# Настройки RabbitMQ
RABBITMQ_URL=amqp://guest:guest@infrastructure-rabbitmq-module:5672/
RABBITMQ_HOST=infrastructure-rabbitmq-module
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Настройки Keycloak
KEYCLOAK_URL=http://infrastructure-keycloak-module:8080
KEYCLOAK_REALM=speculorg
KEYCLOAK_CLIENT_ID=speculorg-client
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Настройки Consul
CONSUL_URL=http://infrastructure-consul-module:8500
CONSUL_HOST=infrastructure-consul-module
CONSUL_PORT=8500

# Настройки Vault
VAULT_URL=http://infrastructure-vault-module:8200
VAULT_HOST=infrastructure-vault-module
VAULT_PORT=8200
VAULT_TOKEN=your-vault-token-here

# Настройки Traefik
TRAEFIK_URL=http://infrastructure-traefik-module:8080
TRAEFIK_HOST=infrastructure-traefik-module
TRAEFIK_PORT=8080

# Настройки OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://infrastructure-opentelemetry-module:4317
OTEL_SERVICE_NAME=speculorg-terminal

# Настройки Prometheus
PROMETHEUS_URL=http://infrastructure-prometheus-module:9090
PROMETHEUS_HOST=infrastructure-prometheus-module
PROMETHEUS_PORT=9090

# Настройки Grafana
GRAFANA_URL=http://infrastructure-grafana-module:3000
GRAFANA_HOST=infrastructure-grafana-module
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Настройки Sentry
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development

# Настройки ELK
ELASTICSEARCH_URL=http://infrastructure-elk-module:9200
ELASTICSEARCH_HOST=infrastructure-elk-module
ELASTICSEARCH_PORT=9200
LOGSTASH_URL=http://infrastructure-elk-module:5044
LOGSTASH_HOST=infrastructure-elk-module
LOGSTASH_PORT=5044
KIBANA_URL=http://infrastructure-elk-module:5601
KIBANA_HOST=infrastructure-elk-module
KIBANA_PORT=5601

# Настройки резервного копирования
BACKUP_DIR=/var/backups
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE="0 0 * * *" 