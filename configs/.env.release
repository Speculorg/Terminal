# Общие настройки
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-production-secret-key-here

# Настройки базы данных
DATABASE_URL=postgresql://speculorg:strong-password@infrastructure-database-module:5432/speculorg
POSTGRES_DB=speculorg
POSTGRES_USER=speculorg
POSTGRES_PASSWORD=strong-password

# Настройки Redis
REDIS_URL=redis://infrastructure-redis-module:6379/0
REDIS_HOST=infrastructure-redis-module
REDIS_PORT=6379
REDIS_PASSWORD=strong-redis-password

# Настройки RabbitMQ
RABBITMQ_URL=amqp://speculorg:strong-password@infrastructure-rabbitmq-module:5672/
RABBITMQ_HOST=infrastructure-rabbitmq-module
RABBITMQ_PORT=5672
RABBITMQ_USER=speculorg
RABBITMQ_PASSWORD=strong-password

# Настройки Keycloak
KEYCLOAK_URL=https://keycloak.speculorg.com
KEYCLOAK_REALM=speculorg
KEYCLOAK_CLIENT_ID=speculorg-client
KEYCLOAK_CLIENT_SECRET=your-production-client-secret-here

# Настройки Consul
CONSUL_URL=https://consul.speculorg.com
CONSUL_HOST=infrastructure-consul-module
CONSUL_PORT=8500
CONSUL_TOKEN=your-production-consul-token

# Настройки Vault
VAULT_URL=https://vault.speculorg.com
VAULT_HOST=infrastructure-vault-module
VAULT_PORT=8200
VAULT_TOKEN=your-production-vault-token

# Настройки Traefik
TRAEFIK_URL=https://traefik.speculorg.com
TRAEFIK_HOST=infrastructure-traefik-module
TRAEFIK_PORT=8080

# Настройки OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.speculorg.com:4317
OTEL_SERVICE_NAME=speculorg-terminal-prod

# Настройки Prometheus
PROMETHEUS_URL=https://prometheus.speculorg.com
PROMETHEUS_HOST=infrastructure-prometheus-module
PROMETHEUS_PORT=9090

# Настройки Grafana
GRAFANA_URL=https://grafana.speculorg.com
GRAFANA_HOST=infrastructure-grafana-module
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=strong-grafana-password

# Настройки Sentry
SENTRY_DSN=your-production-sentry-dsn
SENTRY_ENVIRONMENT=production

# Настройки ELK
ELASTICSEARCH_URL=https://elasticsearch.speculorg.com
ELASTICSEARCH_HOST=infrastructure-elk-module
ELASTICSEARCH_PORT=9200
LOGSTASH_URL=https://logstash.speculorg.com:5044
LOGSTASH_HOST=infrastructure-elk-module
LOGSTASH_PORT=5044
KIBANA_URL=https://kibana.speculorg.com
KIBANA_HOST=infrastructure-elk-module
KIBANA_PORT=5601

# Настройки резервного копирования
BACKUP_DIR=/var/backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 0 * * *"

# Redis
REDIS_DB=0
REDIS_PASSWORD=${REDIS_PASSWORD}

# RabbitMQ
RABBITMQ_VHOST=/
RABBITMQ_PASS=${RABBITMQ_PASSWORD}

# Consul
CONSUL_TOKEN=${CONSUL_TOKEN}

# Vault
VAULT_TOKEN=${VAULT_TOKEN}

# Keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_PASS=${KEYCLOAK_PASSWORD}

# Traefik
TRAEFIK_PASS=${TRAEFIK_PASSWORD}

# Prometheus
PROMETHEUS_PASS=${PROMETHEUS_PASSWORD}

# Grafana
GRAFANA_PASS=${GRAFANA_PASSWORD}

# ELK Stack
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# Sentry
SENTRY_ENVIRONMENT=${SENTRY_ENVIRONMENT}

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT}

# Django
DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY}
DJANGO_DEBUG=${DEBUG}
DJANGO_ALLOWED_HOSTS=${DJANGO_ALLOWED_HOSTS}

# Celery
CELERY_BROKER_URL=${CELERY_BROKER_URL}
CELERY_RESULT_BACKEND=${CELERY_RESULT_BACKEND} 