# Speculorg.Terminal Environment Configuration
# Last updated: 2025-04-09
# Environment: production

# GLOBAL
GLOBAL_DEBUG=false
GLOBAL_ENVIRONMENT=production
GLOBAL_HOSTNAME=specul.org
GLOBAL_LOG_LEVEL=INFO
GLOBAL_SECRET_KEY=strong-production-secret-key
GLOBAL_TIMEZONE=UTC

# INFRASTRUCTURE
INFRASTRUCTURE_SERVICE_HOST=infrastructure-service
INFRASTRUCTURE_SERVICE_PORT=9000
INFRASTRUCTURE_SERVICE_NAME=infrastructure-service
INFRASTRUCTURE_LOG_LEVEL=INFO

INFRASTRUCTURE_CONSUL_HOST=infrastructure-consul-module
INFRASTRUCTURE_CONSUL_PORT=9100
INFRASTRUCTURE_CONSUL_TOKEN=prod-consul-token

INFRASTRUCTURE_VAULT_HOST=infrastructure-vault-module
INFRASTRUCTURE_VAULT_PORT=9101
INFRASTRUCTURE_VAULT_TOKEN=prod-vault-token

INFRASTRUCTURE_KEYCLOAK_HOST=infrastructure-keycloak-module
INFRASTRUCTURE_KEYCLOAK_PORT=9102
INFRASTRUCTURE_KEYCLOAK_REALM=speculorg
INFRASTRUCTURE_KEYCLOAK_CLIENT_ID=speculorg-client
INFRASTRUCTURE_KEYCLOAK_CLIENT_SECRET=strong-client-secret

INFRASTRUCTURE_TRAEFIK_HOST=infrastructure-traefik-module
INFRASTRUCTURE_TRAEFIK_PORT=9103
INFRASTRUCTURE_TRAEFIK_ADMIN_PORT=8081

INFRASTRUCTURE_CELERY_BROKER_URL=redis://infrastructure-redis-module:6379/0
INFRASTRUCTURE_CELERY_RESULT_BACKEND=redis://infrastructure-redis-module:6379/0

# SECURITY
SECURITY_SERVICE_HOST=security-service
SECURITY_SERVICE_PORT=9001
SECURITY_SERVICE_NAME=security-service
SECURITY_LOG_LEVEL=INFO

# MANAGEMENT
MANAGEMENT_SERVICE_HOST=management-service
MANAGEMENT_SERVICE_PORT=9002
MANAGEMENT_SERVICE_NAME=management-service
MANAGEMENT_LOG_LEVEL=INFO

# DATABASE
DATABASE_POSTGRES_DB=speculorg
DATABASE_POSTGRES_HOST=infrastructure-database-module
DATABASE_POSTGRES_PORT=5432
DATABASE_POSTGRES_USER=speculorg
DATABASE_POSTGRES_PASSWORD=strong-db-password

DATABASE_REDIS_HOST=infrastructure-redis-module
DATABASE_REDIS_PORT=6379
DATABASE_REDIS_DB=0
DATABASE_REDIS_PASSWORD=strong-redis-password

# LOGGING (ELK)
LOGGING_ELK_ELASTICSEARCH_HOST=infrastructure-elk-module
LOGGING_ELK_ELASTICSEARCH_PORT=9200
LOGGING_ELK_LOGSTASH_HOST=infrastructure-elk-module
LOGGING_ELK_LOGSTASH_PORT=5044
LOGGING_ELK_KIBANA_HOST=infrastructure-elk-module
LOGGING_ELK_KIBANA_PORT=5601

# MONITORING
MONITORING_OPENTELEMETRY_ENDPOINT=http://infrastructure-opentelemetry-module:4317
MONITORING_OPENTELEMETRY_SERVICE_NAME=speculorg-terminal-prod

MONITORING_PROMETHEUS_HOST=infrastructure-prometheus-module
MONITORING_PROMETHEUS_PORT=9090

MONITORING_GRAFANA_HOST=infrastructure-grafana-module
MONITORING_GRAFANA_PORT=3000
MONITORING_GRAFANA_ADMIN_USER=admin
MONITORING_GRAFANA_ADMIN_PASSWORD=strong-grafana-password

MONITORING_SENTRY_DSN=https://sentry.specul.org
MONITORING_SENTRY_ENVIRONMENT=production
