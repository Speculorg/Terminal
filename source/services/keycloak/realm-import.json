{
    "id": "speculorg",
    "realm": "speculorg",
    "displayName": "Speculorg Realm",
    "enabled": true,
    "roles": {
      "realm": [
        { "name": "admin", "description": "full access" },
        { "name": "user",  "description": "basic access" }
      ]
    },
    "clients": [
      {
        "clientId": "infrastructure-service",
        "secret": "infrastructure-secret",
        "enabled": true,
        "protocol": "openid-connect",
        "publicClient": false,
        "redirectUris": ["*"],
        "standardFlowEnabled": true
      }
    ],
    "users": [
      {
        "username": "admin",
        "enabled": true,
        "emailVerified": true,
        "firstName": "Root",
        "lastName": "Admin",
        "credentials": [
          { "type": "password", "value": "admin", "temporary": false }
        ],
        "realmRoles": ["admin"]
      }
    ]
  }
