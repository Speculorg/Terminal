# TERM-1 canonical configs.env (minimal)
# Источник истины: core/configs/configs.py (Configs.load)

# ---- global ----
GLOBAL_DOMAIN_ROOT=terminal.local
GLOBAL_VERSION=0.0.0-dev

# ---- consul ----
CONSUL_HOST=consul
CONSUL_HTTP_PORT=8500
CONSUL_HTTPS_PORT=8501
# Путь к файлу токена задаётся сервисом (docker-compose env override), если нужно:
# CONSUL_HTTP_TOKEN_FILE=/fs/terminal/secrets/consul_token_for_<svc>

# ---- vault ----
VAULT_HOST=vault
VAULT_HTTP_PORT=8200
VAULT_HTTPS_PORT=8200
VAULT_PKI_ROOT_PATH=pki-root
VAULT_PKI_INT_PATH=pki-int
VAULT_PKI_ROLE=terminal-leaf

# ---- traefik ----
TRAEFIK_HOST=traefik
TRAEFIK_HTTP_PORT=8080
TRAEFIK_HTTPS_PORT=8443

# ---- logging ----
LOGGING_LEVEL=INFO
LOGGING_CORRELATION_ID_HEADER=X-Request-ID
LOGGING_GENERATE_CORRELATION_IF_MISSING=true
LOGGING_CORRELATION_ID_LEN_MAX=64

# ---- metrics ----
METRICS_HOST=0.0.0.0
METRICS_PATH=/metrics
METRICS_PORT=8000

# ---- fs ----
FS_CERTS_DIR=/fs/terminal/certs
FS_SECRETS_DIR=/fs/terminal/secrets
FS_MARKERS_DIR=/fs/terminal/markers
FS_TMP_DIR=/fs/terminal/tmp

# ---- tls ----
# TTL/ротация сертификатов (часов)
TLS_CERTS_ROTATE_HOURS=168
# NONE | SSL_CTX (как у вас принято)
TLS_RELOADER_STRATEGY=SSL_CTX
TLS_WATCH_DEBOUNCE_MS=300
TLS_WATCH_POLL_INTERVAL_MS=500

# ---- kv (оставляем по умолчанию; ключи не задаём, пока не нужны) ----
# KV_CAS_BACKOFF_FACTOR=2
# KV_CAS_RETRIES=4
# KV_REQUEST_TIMEOUT_MS=3000

# ---- fsm ----
FSM_STATE_BOOTSTRAPPING_TIMEOUT_MS=300000
FSM_STATE_INITIALIZING_TIMEOUT_MS=60000
FSM_STATE_SECURING_TIMEOUT_MS=1800000
FSM_STATE_TLS_TRANSITION_TIMEOUT_MS=300000
FSM_STATE_REGISTERING_TIMEOUT_MS=300000
FSM_STATE_RUNNING_TICK_TIMEOUT_MS=1000
FSM_STATE_PUBLISH_MIN_INTERVAL_MS=5000
FSM_DEGRADED_RECOVERY_WINDOW_MS=60000
FSM_DEGRADED_TRANSITION_WINDOW_MS=4000
FSM_DEGRADED_MIN_DURATION_MS=5000

# ---- registrar ----
# TTL должен быть достаточно коротким для детекта, но не флапать на старте
REGISTRAR_TTL_SEC=60
REGISTRAR_HEARTBEAT_PERIOD_SEC=20
# Consul minimum for 'deregister_critical_service_after' is 60s
REGISTRAR_DEREGISTER_CRITICAL_SERVICE_AFTER_SEC=240
REGISTRAR_REREGISTRATION_COOLDOWN_SEC=30
REGISTRAR_MAX_REREG_ATTEMPTS_PER_WINDOW=5
