# TERM-1 canonical configs.env (minimal)
# Источник истины: core/configs/model.py + core/configs/configs.py (Configs.load)

# ---- global ----
GLOBAL_DOMAIN_ROOT=terminal.local

# ---- consul ----
CONSUL_HOST=consul
CONSUL_HTTP_PORT=8500
CONSUL_HTTPS_PORT=8501
# Путь к файлу токена задаётся сервисом (docker-compose env override), если нужно:
# CONSUL_HTTP_TOKEN_FILE=/fs/terminal/secrets/consul_token_for_<svc>

# ---- vault (bootstrap/Pki) ----
VAULT_HTTP_PORT=8200
VAULT_PKI_ROOT_PATH=pki-root
VAULT_PKI_ROLE=terminal-leaf

# ---- logging ----
LOGGING_LEVEL=INFO

# ---- fs ----
FS_CERTS_DIR=/fs/terminal/certs
FS_SECRETS_DIR=/fs/terminal/secrets
FS_MARKERS_DIR=/fs/terminal/markers
FS_TMP_DIR=/fs/terminal/tmp

# ---- tls (watcher for TLS bundle reload) ----
TLS_WATCH_POLL_INTERVAL_MS=500

# ---- fsm ----
FSM_STATE_BOOTSTRAPPING_TIMEOUT_MS=300000
FSM_STATE_INITIALIZING_TIMEOUT_MS=60000
FSM_STATE_SECURING_TIMEOUT_MS=1800000
FSM_STATE_REGISTERING_TIMEOUT_MS=300000
FSM_STATE_RUNNING_TICK_TIMEOUT_MS=1000

# ---- registrar ----
REGISTRAR_TTL_SEC=60
REGISTRAR_HEARTBEAT_PERIOD_SEC=20
# Consul minimum for 'deregister_critical_service_after' is 60s
REGISTRAR_DEREGISTER_CRITICAL_SERVICE_AFTER_SEC=240
REGISTRAR_REREGISTRATION_COOLDOWN_SEC=30
REGISTRAR_MAX_REREG_ATTEMPTS_PER_WINDOW=5