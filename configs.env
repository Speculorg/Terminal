# ---- global ----
GLOBAL_DOMAIN_ROOT=terminal.local
GLOBAL_VERSION=0.0.0-dev
GLOBAL_SAN_LIST=

# ---- context ----
CONTEXT_NAME=default-name-service
CONTEXT_PORT=0
CONTEXT_TAGS=
CONTEXT_CONSUL_HTTP_TOKEN_FILE=

# ---- consul ----
CONSUL_HOST=consul
CONSUL_HTTP_PORT=8500
CONSUL_HTTPS_PORT=8501

# ---- vault ----
VAULT_HOST=vault
VAULT_HTTP_PORT=8200
VAULT_HTTPS_PORT=8200
VAULT_PKI_ROOT_PATH=pki-root
VAULT_PKI_INT_PATH=pki-int
VAULT_PKI_ROLE=terminal-leaf
VAULT_PID=1

# ---- traefik ----
TRAEFIK_HOST=traefik
TRAEFIK_HTTP_PORT=8080
TRAEFIK_HTTPS_PORT=8443

# ---- logging ----
LOGGING_LEVEL=INFO
LOGGING_CORRELATION_ID_HEADER=X-Request-ID
LOGGING_GENERATE_CORRELATION_IF_MISSING=true
LOGGING_CORRELATION_ID_LEN_MAX=64

# ---- metrics ----
METRICS_PATH=/metrics
METRICS_PORT=8000

# ---- fs ----
FS_CERTS_DIR=/fs/terminal/certs
FS_SECRETS_DIR=/fs/terminal/secrets
FS_MARKERS_DIR=/fs/terminal/markers
FS_TMP_DIR=/fs/terminal/tmp
MARKERS_SUFFIX=

# ---- tls ----
TLS_CERTS_ROTATE_HOURS=168
TLS_RELOADER_STRATEGY=SSL_CTX
TLS_WATCH_DEBOUNCE_MS=300
TLS_WATCH_POLL_INTERVAL_MS=500

# ---- fsm ----
FSM_STATE_BOOTSTRAPPING_TIMEOUT_MS=300000
FSM_STATE_INITIALIZING_TIMEOUT_MS=60000
FSM_STATE_SECURING_TIMEOUT_MS=1800000
FSM_STATE_TLS_TRANSITION_TIMEOUT_MS=300000
FSM_STATE_REGISTERING_TIMEOUT_MS=300000
FSM_STATE_RUNNING_TICK_TIMEOUT_MS=1000
FSM_STATE_STARTING_TIMEOUT_MS=60000
FSM_STATE_PUBLISH_MIN_INTERVAL_MS=5000
FSM_DEGRADED_RECOVERY_WINDOW_MS=60000
FSM_DEGRADED_TRANSITION_WINDOW_MS=4000
FSM_DEGRADED_MIN_DURATION_MS=5000

# retry backoff to reduce noise
FSM_RETRY_SLEEP_MS=200
FSM_RETRY_SLEEP_REGISTERING_MS=1000
FSM_RETRY_SLEEP_SECURING_MS=500
FSM_RETRY_SLEEP_BOOTSTRAPPING_MS=500
FSM_RETRY_SLEEP_PAUSED_MS=500

# ---- registrar (NORMALIZED) ----
# TTL should be short enough to detect failure, but not so short it flaps on startup.
REGISTRAR_TTL_SEC=20
REGISTRAR_HEARTBEAT_PERIOD_SEC=7

# Consul minimum for 'deregister_critical_service_after' is 60s.
# Use 90s to avoid borderline flaps during transient startup/network hiccups.
REGISTRAR_DEREGISTER_CRITICAL_SERVICE_AFTER_SEC=90

# cooldown between register attempts (works together with policy backoff)
REGISTRAR_REREGISTRATION_COOLDOWN_SEC=15

# window-limiter: number of register attempts per critical window
REGISTRAR_MAX_REREG_ATTEMPTS_PER_WINDOW=5

# optional backoff tuning (RegistrarPolicy uses these if present)
REGISTRAR_BACKOFF_BASE_SEC=1
REGISTRAR_BACKOFF_CAP_SEC=30
REGISTRAR_HEARTBEAT_BACKOFF_BASE_SEC=2
REGISTRAR_HEARTBEAT_BACKOFF_CAP_SEC=30
